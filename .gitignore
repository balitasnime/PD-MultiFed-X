vit3d_test_metrics.csv
FINAL_METRICS_ALL_HORIZONS.csv
FINAL_PER_CLASS_TABLE_T2_T4_T6.csv
FINAL_PUBLICATION_TABLE_T2_T4_T6_SEEDS42_46.csv
