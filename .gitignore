# ============================================================
# PD-MultiFed-X — .gitignore
# ============================================================

# ---- PPMI / Clinical & Imaging Data (NEVER COMMIT) ----------
# PPMI participant-level data must never be pushed to GitHub.
# NOTE: no blanket "*.csv" rule here — the RAG knowledge-base CSVs under
# rag/ are public reference data (PubMed/web sources), not patient data,
# and are intentionally tracked. Only specific patient-derived CSVs are
# ignored by name below.
data/
raw_data/
mri_data/
clinical_data/
Demographics.csv
Participant_Status.csv
Geriatric_Depression_Scale.csv
Epworth_Sleepiness_Scale.csv
REM_Sleep_Behavior.csv
SCOPA-AUT.csv
MDS-UPDRS_Part_I.csv
MDS-UPDRS_Part_IV.csv
UPDRS_PartII_PartIII.xlsx
mri_features.csv
mri_featuress.csv
mri_features_seed42_for_fed_and_xai.csv
all_test_predictions.csv
FINAL_METRICS_ALL_HORIZONS.csv
FINAL_PER_CLASS_TABLE_T2_T4_T6.csv
FINAL_PUBLICATION_TABLE_T2_T4_T6_SEEDS42_46.csv
vit3d_test_metrics.csv

# ---- MRI volumes / imaging formats (project uses DICOM via pydicom) ----
*.dcm
*.dicom
*.nii
*.nii.gz
*.mgz
*.img
*.hdr
dataimage/
imagedataset/

# ---- Kaggle / Colab working directories (found hardcoded in notebooks) ----
kaggle/working/
/content/
drive/MyDrive/

